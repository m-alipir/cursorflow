1 24 "../app.manifest"
MAINICON ICON "app_icon.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CursorFlow"
            VALUE "FileDescription", "CursorFlow - smooth cursor overlay"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CursorFlow"
            VALUE "LegalCopyright", "Copyright (c) 2026 m-alipir. MIT with Commons Clause."
            VALUE "OriginalFilename", "CursorFlow.exe"
            VALUE "ProductName", "CursorFlow"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
